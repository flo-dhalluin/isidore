# Copy to `.env` beside compose.yaml and edit:
#
#     cp .env.example .env
#
# Compose reads `.env` automatically. Only PI_SANDBOX_KEY_FILE is required; the
# commented values are the defaults compose uses when the variable is unset.
# Values are interpolated but not shell-expanded, so use `$HOME`, not `~`.
# See README.md.

# --- required -------------------------------------------------------------
# A 0600 file holding the OpenRouter API key. It is bind-mounted read-only as
# the `openrouter` secret (never an env var, argument or image layer). Create
# it with, for example:
#     (umask 077; printf '%s' 'sk-or-...' > "$HOME/.openrouter-key")
PI_SANDBOX_KEY_FILE=$HOME/.openrouter-key

# --- identity -------------------------------------------------------------
# uid:gid the services run as; must own the state dirs below. Uncomment to use
# your own ids when they are not 1000:1000.
#PI_UID=1000
#PI_GID=1000

# --- Pi image -------------------------------------------------------------
#PI_VERSION=latest
#PI_WEB_PACKAGE=pi-web-access
# Default model for spawned tasks ("provider/model"); empty = Pi's default.
#PI_SANDBOX_MODEL=

# --- state (bind mounts; created by you, writable by PI_UID:PI_GID) -------
#ISIDORE_STATE=$HOME/.local/state/pi-sandbox/isidore
#SCHEDULER_STATE=$HOME/.local/state/pi-sandbox/scheduler

# --- isidore --------------------------------------------------------------
#ISIDORE_PORT=8920
# Admin bearer token for the isidore API/UI. OPTIONAL: when unset, isidore
# generates one at startup, logs it to stderr, and writes it to
# <ISIDORE_STATE>/shared/admin-token (0600). Retrieve it out-of-band with:
#     docker compose exec isidore cat /state/shared/admin-token
# then open http://127.0.0.1:8920/?token=<TOKEN>. It is deliberately NOT served
# to the loopback UI: tasks share isidore's network namespace and could harvest
# an injected token. The scheduler reads the same file via the isidore-admin
# volume, so it authenticates even when this is left unset.
#ISIDORE_TOKEN=
#ISIDORE_MAX_WORKERS=2
#ISIDORE_TASK_TIMEOUT=
# A 0600 file holding the Telegram bot token, mounted as the `telegram`
# secret; unset = no bot. See README.md "Telegram".
#ISIDORE_TELEGRAM_TOKEN_FILE=$HOME/.telegram-token
#ISIDORE_TELEGRAM_CHATS=
# Public HTTPS URL a reverse proxy forwards to isidore's /telegram/webhook;
# unset = long polling (no inbound access needed).
#ISIDORE_TELEGRAM_WEBHOOK_URL=https://bot.example.com/telegram/webhook

# --- scheduler ------------------------------------------------------------
#SCHEDULER_TOKEN=
#SCHEDULER_TICK=1
#SCHEDULER_RETRY_DELAY=30

# --- browser --------------------------------------------------------------
# 1 exposes browser_evaluate (arbitrary JS in the page).
#BROWSER_MCP_ALLOW_JS=0

# --- git identity inside tasks --------------------------------------------
#GIT_AUTHOR_NAME=pi-sandbox
#GIT_AUTHOR_EMAIL=pi-sandbox@localhost

# --- resource limits ------------------------------------------------------
#BROWSER_MCP_MEMORY=3g
#ISIDORE_MEMORY=4g
#SCHEDULER_MEMORY=256m
#PI_SANDBOX_PIDS=512
#PI_SANDBOX_TMP_SIZE=2g

# --- misc -----------------------------------------------------------------
#TZ=
#LANG=C.UTF-8
